# gRPC address of the db-server (change to remote IP when deployed)
DB_GRPC_URL=localhost:50051

# --- LLM Provider: "groq" | "ollama" | "anthropic" ---
LLM_PROVIDER=groq

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Groq settings (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic settings (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

PORT=3000
NODE_ENV=development
MAX_QUERY_RESULTS=50
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
